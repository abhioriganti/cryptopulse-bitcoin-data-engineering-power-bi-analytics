// TMDL measure fragment. Confirm syntax against the PBIP generated by your installed Power BI Desktop.
// Model contract and the full DAX source are in ../dax/CryptoPulseMeasures.dax.
table Measures
    measure 'Latest BTC Price' =
        VAR LatestBar = CALCULATE(MAX('Fact Market Bar'[bar_start]), ALL('Fact Market Bar'))
        RETURN CALCULATE(MAX('Fact Market Bar'[close]), 'Fact Market Bar'[bar_start] = LatestBar)
        displayFolder: Market\\Price

    measure 'Anomaly Count' = COUNTROWS('Anomalies')
        displayFolder: Reliability
