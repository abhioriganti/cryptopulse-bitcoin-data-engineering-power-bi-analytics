# Application profile: development, test, production
CRYPTOPULSE_ENVIRONMENT=development
CRYPTOPULSE_LOG_LEVEL=INFO
CRYPTOPULSE_SYMBOL=BTC-USD
CRYPTOPULSE_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
CRYPTOPULSE_KAFKA_TOPIC=market-events
CRYPTOPULSE_POSTGRES_DSN=postgresql://cryptopulse:cryptopulse@localhost:15432/cryptopulse
CRYPTOPULSE_S3_ENDPOINT=http://localhost:9000
CRYPTOPULSE_S3_BUCKET=cryptopulse-lakehouse
CRYPTOPULSE_S3_ACCESS_KEY=change-me
CRYPTOPULSE_S3_SECRET_KEY=change-me
CRYPTOPULSE_MLFLOW_TRACKING_URI=http://mlflow:5000
CRYPTOPULSE_PROVIDER_TIMEOUT_SECONDS=20
CRYPTOPULSE_ALLOWED_LATENESS_MINUTES=15
# Configure only when a selected provider needs a credential.
CRYPTOPULSE_PROVIDER_API_KEY=
# Optional OpenAI-compatible endpoint for the read-only analytics assistant.
CRYPTOPULSE_LLM_API_KEY=
CRYPTOPULSE_LLM_BASE_URL=
